{
  "name": "@webqit/realdom",
  "title": "RealDOM",
  "description": "Low-level DOM APIs.",
  "keywords": [
    "DOM",
    "Mutation Observer",
    "realtime-dom",
    "reactive DOM library"
  ],
  "version": "2.1.38",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webqit/realdom.git"
  },
  "bugs": {
    "url": "https://github.com/webqit/realdom/issues"
  },
  "type": "module",
  "sideEffects": false,
  "browser": {
    "fs": false
  },
  "main": "./src/index.js",
  "scripts": {
    "test": "mocha --extension .test.js --recursive --timeout 5000 --exit",
    "build": "esbuild main=src/targets.browser.js --bundle --keep-names --minify --sourcemap --outdir=dist",
    "preversion": "npm run test && npm run build",
    "postversion": "git push && git push --tags",
    "version:next": "npm version prerelease --preid=next"
  },
  "dependencies": {
    "@webqit/util": "^0.8.19"
  },
  "devDependencies": {
    "chai": "^4.3.4",
    "coveralls": "^3.1.1",
    "esbuild": "^0.14.43",
    "jsdom": "^20.0.0",
    "mocha": "^9.0.2",
    "mocha-lcov-reporter": "^1.3.0"
  },
  "author": "Oxford Harrison <oxharris.dev@gmail.com>",
  "maintainers": [
    "Oxford Harrison <oxharris.dev@gmail.com>"
  ],
  "contributors": []
}
